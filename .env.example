POSTGRES_DB=onthepitch
POSTGRES_USER=onthepitch
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
JWT_SECRET=
PORT=3000
API_ADRESSE_URL=https://api-adresse.data.gouv.fr/search
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/onthepitch"

# SMTP réel pour les notifications par email (voir CLAUDE.md, section
# "Notifications") — facultatif : si l'une de ces variables est absente,
# NotificationEmailNodemailer retombe automatiquement sur un compte de test
# Ethereal (aperçu web, aucun envoi réel), pratique pour développer sans
# configurer quoi que ce soit.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optionnel — adresse qui reçoit les messages du formulaire de contact
# (page Aide). "support@onthepitch.local" par défaut (adresse fictive : avec le
# compte de test Ethereal, le message reste consultable par lien d'aperçu).
SUPPORT_EMAIL=

# Optionnel — nom affiché dans l'application d'authentification (double
# authentification), "OnThePitch" par défaut.
APP_NAME=

# Optionnel — nombre de proxys de confiance devant l'API (nginx, ingress).
# À poser au déploiement derrière un proxy, sinon le limiteur de tentatives voit
# tout le monde sous l'IP du proxy. Laisser vide en local.
TRUST_PROXY=

# Optionnel — nombre d'échecs tolérés par IP et par tranche de 15 minutes sur la
# connexion et les confirmations du compte (10 par défaut). À relever seulement
# pour rejouer la suite E2E en boucle.
LIMITE_TENTATIVES=
